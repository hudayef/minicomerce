# Environment Variables (Template)
# Catatan: Saat ini sistem belum mengimplementasikan fitur database/SMTP.
# Variabel ini disiapkan sebagai konfigurasi di masa mendatang.

# --- KONFIGURASI APLIKASI ---
# Nama dari aplikasi e-commerce
APP_NAME="Toko E-Commerce"
# Lingkungan aplikasi (local, staging, production)
APP_ENV=local
# Mode debug untuk menampilkan error secara rinci (true/false)
APP_DEBUG=true
# URL base dari aplikasi (misal: http://localhost:8000)
APP_URL=http://localhost:8000

# --- KONFIGURASI DATABASE ---
# (Status: Not Implemented / Planned - Berikut adalah rancangan variabel koneksi database MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_db
DB_USERNAME=root
DB_PASSWORD=

# --- KONFIGURASI KEAMANAN ---
# (Status: Not Implemented / Planned - Akan digunakan untuk Hash / JWT Token / CSRF salt)
APP_KEY=

# --- KONFIGURASI SMTP / EMAIL ---
# (Status: Not Implemented / Planned - Untuk fitur lupa password atau notifikasi pesanan)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
